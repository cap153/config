{
    "layer": "top",
    "position": "bottom",
    "height": 29,
    // "width": 1366,
    "modules-left": ["custom/rrwm_tags"],
    // "modules-center": ["niri/workspaces"],
    "modules-right": ["wireplumber", "bluetooth", "disk", "cpu", "memory", "battery", "clock", "tray"],
    
    "custom/rrwm_tags": {
        "format": "{}",
        "return-type": "json",
        "exec": "rrwm --waybar",
        "escape": false
    },
    
    "wlr/taskbar": {
        "format": "{icon}",
        "tooltip-format": "{title} | {app_id}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "fullscreen"
    },
    
    "niri/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "1:web": "",
            "2:code": "",
            "3:term": "",
            "4:work": "",
            "5:music": "",
            "6:docs": ""
        }
    },
    
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    
    "wireplumber": {
        // 删除了末尾的多余空格
        "format": "{icon} {volume}%",
        "format-muted": "",
        "on-click": "pwvucontrol",
        // "format-icons": ["", ""]
        "format-icons": ""
    },
    
    "bluetooth": {
        "format": " {status}",
        // 删除了末尾的多余空格
        "format-connected-battery": " {device_battery_percentage}%",
        "on-click": "blueberry"
    },

    "disk":{
        "format": "󰋊 {percentage_free}%"
    },

    "cpu": {
        "format": "󰻠 {usage}%"
    },

    "memory": { //  
        "format": "󰉉 {}%"
    },
    

    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        // 删除了不规则的连续空格，统一为单空格
        "format": "<span color='#ffffff'>{icon}</span> {capacity}%",
        "format-charging": "<span color='#e88939'></span> {capacity}% {time}",
        "format-plugged": "<span color='#e88939'>{icon} </span> {capacity}%",
        "format-discharging": "<span color='#e88939'>{icon}</span> {capacity}% ({time})",
        "format-icons": ["", "", "", "", ""]
    },
    
    "clock": {
        // 统一了日期、图标和时间之间的标准单空格   
        "format": " {:%Y-%m-%d 󰅐 %H:%M}"
    },

    "network": {
        // "interface": "wlp2s0",
        "format-wifi": " {essid}: {ipaddr}/{cidr}",
        "format-ethernet": " {ifname}: {ipaddr}/{cidr}",
        "format-disconnected": "⚠ Disconnected"
    }
}
